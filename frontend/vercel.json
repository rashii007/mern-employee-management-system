{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mern-employee-management-system-5ly3.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
